# Leave unset for the default (recommended) deploy: client + API served
# from the same Vercel project/domain, so the client just calls same-origin
# /api/... paths. Also leave unset for local dev — Vite proxies /api to the
# local Express server (see vite.config.js).
#
# Only set this if you deploy the client somewhere separate from the API
# (e.g. Netlify for the frontend + a standalone server elsewhere):
# VITE_API_URL=https://your-api-host.example.com/api
VITE_API_URL=

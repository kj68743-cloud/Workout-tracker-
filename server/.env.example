# Port the API server listens on (only used when running as a standalone
# process — local dev, Docker, Fly, Railway, a VPS. Not used on Vercel).
PORT=4000

# --- Local/file-based SQLite (default) ---
# Directory where the local SQLite file is stored when TURSO_DATABASE_URL
# is not set. Defaults to ./data inside the server folder if unset.
# DATA_DIR=/data

# --- Hosted libSQL (Turso) ---
# Set both to point the app at a hosted database instead of a local file.
# This is what makes the app work on stateless/serverless hosts (Vercel,
# Render free tier, etc.) since the data lives off-box. Get these from
# your Turso dashboard (turso.tech) — no CLI required.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-token
